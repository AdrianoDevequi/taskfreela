generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              user    @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Account_userId_fkey")

  @@unique([provider, providerAccountId], map: "Account_provider_providerAccountId_key")
  @@index([userId], map: "Account_userId_fkey")
}

model workspace {
  id              String            @id @default(uuid())
  name            String
  slug            String            @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  members         WorkspaceMember[]
  activeUsers     user[]            @relation("ActiveWorkspace")
  tasks           task[]
  reminders       reminder[]
  integrations    integration[]
  projects        project[]

  @@map("Workspace")
}

model integration {
  id           String     @id @default(uuid())
  provider     String
  accessToken  String     @db.Text
  refreshToken String?    @db.Text
  expiresAt    BigInt?
  calendarId   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  accountEmail String?
  userId       String?
  workspaceId  String?
  user         user?      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Integration_userId_fkey")
  workspace    workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "Integration_workspaceId_fkey")

  @@index([userId], map: "Integration_userId_idx")
  @@index([workspaceId], map: "Integration_workspaceId_idx")
}

model reminder {
  id          String     @id @default(uuid())
  content     String
  isCompleted Boolean    @default(false)
  createdAt   DateTime   @default(now())
  userId      String?
  workspaceId String?
  user        user?      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Reminder_userId_fkey")
  workspace   workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "Reminder_workspaceId_fkey")

  @@index([userId], map: "Reminder_userId_idx")
  @@index([workspaceId], map: "Reminder_workspaceId_idx")
}

model session {
  id           String   @id @default(uuid())
  sessionToken String   @unique(map: "Session_sessionToken_key")
  userId       String
  expires      DateTime
  user         user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Session_userId_fkey")

  @@index([userId], map: "Session_userId_fkey")
}

model task {
  id            Int        @id @default(autoincrement())
  title         String
  description   String?    @db.Text
  dueDate       DateTime
  status        String     @default("TODO")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  estimatedTime String?
  isMandatory   Boolean    @default(false)
  isRecurring   Boolean    @default(false)
  recurrencePattern String?
  recurrenceDays String?
  userId        String?
  workspaceId   String?
  assignedToId  String?
  projectId            String?
  originalAssignedToId String?
  user          user?      @relation("TaskCreator", fields: [userId], references: [id], onDelete: Cascade, map: "Task_userId_fkey")
  assignedTo    user?      @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull, map: "Task_assignedToId_fkey")
  workspace     workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "Task_workspaceId_fkey")
  project       project?   @relation(fields: [projectId], references: [id], onDelete: SetNull, map: "Task_projectId_fkey")
  comments      comment[]

  @@index([userId], map: "Task_userId_idx")
  @@index([workspaceId], map: "Task_workspaceId_idx")
  @@index([assignedToId], map: "Task_assignedToId_idx")
  @@index([projectId], map: "Task_projectId_idx")
}

model comment {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  taskId    Int
  userId    String
  task      task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
}


model user {
  id                String            @id @default(uuid())
  name              String?
  email             String?           @unique(map: "User_email_key")
  emailVerified     DateTime?
  image             String?
  password          String?
  activeWorkspaceId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  account           account[]
  integration       integration[]
  reminder          reminder[]
  session           session[]
  whatsapp          String?
  notifyDailySummary Boolean @default(true)
  notifyNewTasks     Boolean @default(true)
  notifyOverdueTasks Boolean @default(true)
  notifyMandatoryTasks Boolean @default(true)
  showTeamTasks      Boolean @default(false)
  isSuperAdmin       Boolean @default(false)
  lastLoginAt        DateTime?
  createdTasks      task[]            @relation("TaskCreator")
  assignedTasks     task[]            @relation("TaskAssignee")
  activeWorkspace   workspace?        @relation("ActiveWorkspace", fields: [activeWorkspaceId], references: [id], onDelete: SetNull)
  workspaceMembers  WorkspaceMember[]
  comments          comment[]
  pushSubscriptions PushSubscription[]
  whatsappServers   WhatsappServer[]
  whatsappInstances WhatsappInstance[]

  @@index([activeWorkspaceId])
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  userId      String
  workspaceId String
  role        String    @default("EMPLOYEE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([userId])
  @@index([workspaceId])
}

model verificationtoken {
  identifier String
  token      String   @unique(map: "VerificationToken_token_key")
  expires    DateTime

  @@unique([identifier, token], map: "VerificationToken_identifier_token_key")
}

model Settings {
  id                Int    @id @default(1)
  apiUrl            String @default("")
  apiKey            String @default("")
  instanceName      String @default("")
  notificationPhone String @default("")

  @@map("settings")
}

model project {
  id          String     @id @default(uuid())
  name        String
  description String?    @db.Text
  url         String?    @db.VarChar(512)
  status      String     @default("ACTIVE")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspaceId String
  workspace   workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "Project_workspaceId_fkey")
  tasks       task[]

  @@index([workspaceId], map: "Project_workspaceId_idx")
  @@map("Project")
}

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique @db.VarChar(512)
  p256dh    String   @db.Text
  auth      String   @db.Text
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ── Central Multi-WhatsApp (Evolution API, por usuário) ──────────────────────

model WhatsappServer {
  id        String             @id @default(uuid())
  userId    String
  label     String?
  baseUrl   String             @db.VarChar(512)
  apiKey    String             @db.Text // criptografada em repouso (lib/crypto)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      user               @relation(fields: [userId], references: [id], onDelete: Cascade)
  instances WhatsappInstance[]

  @@index([userId])
}

model WhatsappInstance {
  id               String            @id @default(uuid())
  serverId         String
  userId           String
  instanceName     String
  number           String?
  profileName      String?
  connectionStatus String            @default("close") // open | close | connecting
  webhookSecret    String
  lastSyncAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  server           WhatsappServer    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user             user              @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts         WhatsappContact[]
  chats            WhatsappChat[]
  messages         WhatsappMessage[]

  @@unique([serverId, instanceName])
  @@index([userId])
}

model WhatsappContact {
  id         String           @id @default(uuid())
  instanceId String
  remoteJid  String
  pushName   String?
  isSaved    Boolean          @default(false)
  isGroup    Boolean          @default(false)
  updatedAt  DateTime         @updatedAt
  instance   WhatsappInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, remoteJid])
  @@index([instanceId])
}

model WhatsappChat {
  id                  String            @id @default(uuid())
  instanceId          String
  remoteJid           String
  type                String            @default("person") // person | group
  name                String?
  lastMessageAt       DateTime?
  lastFromMe          Boolean           @default(false)
  lastPreview         String?           @db.Text
  unreadCount         Int               @default(0)
  priority            String            @default("medium") // high | medium | low
  status              String            @default("pending") // pending | answered | resolved
  resolvedAt          DateTime?
  firstPendingAt      DateTime?
  lastResponseSeconds Int?
  slaAlertedAt        DateTime?
  isMuted             Boolean           @default(false)
  ignored             Boolean           @default(false)
  updatedAt           DateTime          @updatedAt
  instance            WhatsappInstance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  messages            WhatsappMessage[]

  @@unique([instanceId, remoteJid])
  @@index([instanceId])
  @@index([status])
}

model WhatsappMessage {
  id         String           @id @default(uuid())
  instanceId String
  chatId     String
  messageId  String
  remoteJid  String
  fromMe     Boolean
  type       String
  preview    String?          @db.Text
  timestamp  DateTime
  createdAt  DateTime         @default(now())
  instance   WhatsappInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  chat       WhatsappChat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([instanceId, messageId])
  @@index([chatId])
  @@index([timestamp])
}
